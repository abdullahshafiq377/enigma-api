# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Backend runs on 4000 so the Next.js frontend can use the default port 3000
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend URL(s))
CORS_ORIGINS=http://localhost:3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── Database (MongoDB Atlas connection string — NOT the Atlas Admin API key) ─
MONGODB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/enigma?retryWrites=true&w=majority

# ─── Clerk (optional until auth is wired) ─────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ─── AWS video stack (optional until the media pipeline is wired) ─────────────
AWS_REGION=
AWS_S3_INPUT_BUCKET=
AWS_S3_OUTPUT_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
