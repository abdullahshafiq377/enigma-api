{
  "name": "enigma-backend",
  "version": "1.0.0",
  "description": "Enigma University - Express 5 + TypeScript + MongoDB API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "make-admin": "tsx src/scripts/make-admin.ts",
    "seed-admin": "tsx src/scripts/seed-admin.ts",
    "seed-analytics": "tsx src/scripts/seed-analytics.ts",
    "sync-indexes": "tsx src/scripts/sync-indexes.ts",
    "check-aws": "tsx src/scripts/check-aws.ts",
    "check-protection": "tsx src/scripts/check-protection.ts",
    "rotate-cf-key": "tsx src/scripts/rotate-cf-key.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "enigma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-transcribe": "^3.1075.0",
    "@aws-sdk/cloudfront-signer": "^3.1074.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@clerk/express": "^2.1.30",
    "@react-pdf/renderer": "^4.5.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react": "^19.2.7",
    "svix": "^1.96.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
